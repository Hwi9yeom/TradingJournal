# =============================================================================
# .env.example — copy to .env and fill in real values: `cp .env.example .env`
# .env is git-ignored. NEVER commit real secrets.
#
# docker-compose.yml requires the password vars below to be set (no insecure
# built-in defaults); `docker compose up` fails fast if any are missing.
# =============================================================================

# --- PostgreSQL (default prod/local DB, used by the `app` and `backup` services) ---
DB_PASSWORD=change-me-postgres-password

# --- MySQL (only needed when running the `mysql` service / `mysql` Spring profile) ---
MYSQL_USERNAME=tradingjournal
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
# TLS mode for the MySQL JDBC connection: DISABLED | PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY
# DB_SSL_MODE=PREFERRED

# --- Application secrets ---
# Generate a strong random value, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-jwt-secret
# Optional AES key for field-level encryption (leave empty to disable)
ENCRYPTION_KEY=

# --- Optional integrations ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# REDIS_PASSWORD=
